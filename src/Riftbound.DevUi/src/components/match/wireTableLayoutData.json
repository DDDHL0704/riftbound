{
  "runeDeckSize": 12,
  "arena": {
    "battlefieldMinHeightRatio": 0.34,
    "handMaxViewportRatio": 0.15,
    "battlefieldSlots": ["leftSite", "leftLane", "rightLane", "rightSite"],
    "desktopMinWidth": 1280,
    "compactDesktopMinWidth": 900,
    "self": {
      "runes": "bottomLeft",
      "home": "bottomCenter",
      "mainDeck": "bottomRight",
      "hand": "bottomFan"
    },
    "opponent": {
      "runes": "topRight",
      "home": "topCenter",
      "mainDeck": "topLeft",
      "hiddenHand": "topFan"
    }
  },
  "tokens": {
    "cardWidth": 82,
    "cardHeight": 115,
    "fixedPileCardWidth": 76,
    "fixedPileCardHeight": 106,
    "fixedPileSlotWidth": 76,
    "fixedPileSlotHeight": 106,
    "battlefieldCardWidth": 148,
    "battlefieldCardHeight": 104,
    "runeCardWidth": 48,
    "runeCardHeight": 67,
    "cardGap": 4,
    "deckAreaWidth": 80,
    "publicPileWidth": 84,
    "handPilesWidth": 168,
    "runeTrackWidth": 480,
    "signatureAreaWidth": 88,
    "signatureZoneHeight": 122,
    "standbyTrackHeight": 96,
    "standbyTrackMinHeight": 88,
    "heroAreaWidth": 88,
    "tableMinWidth": 1280,
    "tableMinHeight": 892
  },
  "table": {
    "rowTemplates": ["150px", "166px", "minmax(230px, 1fr)", "166px", "150px"],
    "rows": [
      { "id": "opponent-hand", "kind": "handRail", "side": "opponent" },
      { "id": "opponent-home", "kind": "playerHome", "side": "opponent" },
      { "id": "battlefield", "kind": "battlefield" },
      { "id": "self-home", "kind": "playerHome", "side": "self" },
      { "id": "self-hand", "kind": "handRail", "side": "self" }
    ]
  },
  "handRails": {
    "self": {
      "columns": ["var(--wire-deck-area-w)", "var(--wire-rune-track-w)", "minmax(360px, 1fr)"],
      "slots": ["runeDeck", "runeTrack", "hand"],
      "handBodyColumns": ["minmax(0, 1fr)", "var(--wire-hand-piles-w)"],
      "handBodySlots": ["cards", "piles"],
      "pileSlots": ["library", "played"],
      "runeReverse": false
    },
    "opponent": {
      "columns": ["minmax(360px, 1fr)", "var(--wire-rune-track-w)", "var(--wire-deck-area-w)"],
      "slots": ["hand", "runeTrack", "runeDeck"],
      "handBodyColumns": ["var(--wire-hand-piles-w)", "minmax(0, 1fr)"],
      "handBodySlots": ["piles", "cards"],
      "pileSlots": ["played", "library"],
      "runeReverse": true
    }
  },
  "playerHomes": {
    "self": {
      "columns": ["var(--wire-signature-area-w)", "var(--wire-hero-area-w)", "minmax(0, 1fr)"],
      "slots": ["legend", "hero", "base"],
      "baseColumns": ["minmax(0, 1fr)", "var(--wire-public-pile-w)"],
      "baseSlots": ["base", "banish"]
    },
    "opponent": {
      "columns": ["minmax(0, 1fr)", "var(--wire-hero-area-w)", "var(--wire-signature-area-w)"],
      "slots": ["base", "hero", "legend"],
      "baseColumns": ["var(--wire-public-pile-w)", "minmax(0, 1fr)"],
      "baseSlots": ["banish", "base"]
    }
  },
  "battlefield": {
    "columns": ["var(--wire-battlefield-card-w)", "minmax(0, 1fr)", "var(--wire-battlefield-card-w)"],
    "slots": ["leftSite", "center", "rightSite"],
    "centerColumns": ["minmax(0, 1fr)", "minmax(0, 1fr)"],
    "laneRows": ["minmax(var(--wire-card-h), 1fr)", "minmax(var(--wire-card-h), 1fr)"],
    "laneZones": [
      { "id": "left-lane", "laneIndex": 0, "unitZoneIds": ["left-opponent", "left-self"], "standbyZoneId": "left-standby" },
      { "id": "right-lane", "laneIndex": 1, "unitZoneIds": ["right-opponent", "right-self"], "standbyZoneId": "right-standby" }
    ],
    "unitZones": [
      { "id": "left-opponent", "laneIndex": 0, "side": "opponent" },
      { "id": "right-opponent", "laneIndex": 1, "side": "opponent" },
      { "id": "left-self", "laneIndex": 0, "side": "self" },
      { "id": "right-self", "laneIndex": 1, "side": "self" }
    ]
  },
  "sidePanel": {
    "slots": [
      "overview",
      "turnWindow",
      "commandCenter",
      "serverFlow",
      "responseCoach",
      "tableAuthority",
      "informationBoundary",
      "promptAuthority",
      "actionMap",
      "interaction",
      "ruleQueue",
      "timelineDetail",
      "actionPrompt",
      "log"
    ]
  }
}
