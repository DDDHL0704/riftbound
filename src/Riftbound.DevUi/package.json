{
  "name": "riftbound-dev-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:event-labels": "node scripts/check-event-labels.mjs",
    "check:tabletop-layout": "node scripts/check-tabletop-layout.mjs",
    "check:user-facing-text": "node scripts/check-user-facing-text.mjs",
    "check:wire-table-layout": "node scripts/check-wire-table-layout.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck:strict": "tsc -b --pretty false",
    "check:focused-object-plan": "node scripts/check-focused-object-command-plan.mjs",
    "build": "npm run check:event-labels && npm run check:user-facing-text && npm run check:tabletop-layout && npm run check:wire-table-layout && npm run check:focused-object-plan && npm run typecheck:strict && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "e2e:formal-18": "node scripts/chrome-formal-18-e2e.mjs",
    "smoke:chrome": "node scripts/chrome-smoke.mjs",
    "qa:appshots": "node scripts/playwright-qa.mjs",
    "qa:appshots:update": "node scripts/playwright-qa.mjs --update-baseline",
    "qa:frontend": "npm run build && npm run smoke:chrome && npm run qa:appshots"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-tooltip": "^1.2.10",
    "lucide-react": "^1.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.12.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
