      "document": "DOC-04",
      "page": 36,
      "clauseAnchors": [
        "316.9.b"
      ],
      "text": "316.9.b.                   游戏继续进行至回合结束阶段。",
      "reviewStatus": "NOT_REVIEWED",
      "implementation": [],
      "tests": []
    },
    {
