    "clauseAnchors": [
      "421.1"
    ],
    "text": "421.1.          将一张卡面朝下放在你控制的战场上,即视为让该卡牌进入待命状态。",
    "reviewStatus": "NOT_REVIEWED",
    "implementation": [],
    "tests": []
