; Engine configuration file.
; Keep gameplay authority in the existing server; this client only renders
; snapshots and submits commands.

config_version=5

[application]

config/name="Riftbound Godot Client"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="Riftbound.GodotClient"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
